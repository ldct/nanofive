def table : Nat × Array (BitVec 8) := (0x10069, #[1, 1])

def bytes : Bytes := fun a =>
  if table.1 ≤ a ∧ a < table.1 + table.2.size then table.2[a - table.1]?
  else code.findSome? fun (start, words) =>
    if start ≤ a then
      let offset := a - start
      words[offset / 4]?.map fun (w : BitVec 32) => (w >>> (8 * (offset % 4))).setWidth 8
    else none

